# Local MongoDB defaults. The V1 apps use one shared database and collection.
MONGODB_URI=mongodb://127.0.0.1:27017
TUTOR_DB_NAME=local
TUTOR_COLLECTION=Student_Data

# Azure OpenAI is called by the parent server only. Tutor servers use
# MODEL_PARENT_URL and their MODEL_GATEWAY_TOKEN_TUTOR_* value.
AZURE_OPENAI_ENDPOINT=https://<resource-name>.openai.azure.com/openai/v1
AZURE_OPENAI_API_KEY=
# First launch seeds the active release. A changed value on restart stages and
# checks a candidate; the current active model keeps serving until an admin
# reviews the results and promotes it in the parent dashboard.
TUTOR_MODEL=gpt-5-mini

# V2 parent application. The parent server owns the Azure key and active model.
# The tutor applications send their MongoDB context to this parent gateway.
MODEL_PARENT_URL=http://127.0.0.1:8765
MODEL_ADMIN_TOKEN=replace-with-a-different-long-random-secret
MODEL_CONTROL_STATE_PATH=config/model_control.json
# Number of paired generations per case during candidate evaluation (2-5).
MODEL_EVAL_REPETITIONS=3
# One to three distinct Azure deployment names for the judge panel. Do not
# include the candidate deployment; each judge must pass in both blind answer
# orders. Using the active model as judge is allowed with a visible warning,
# but its opinion is not independent. Leave blank only while configuring.
MODEL_EVAL_JUDGE_MODELS=

# Optional self-hosted Langfuse tracing for the parent only. Use project keys
# from the Langfuse project at http://localhost:3000. Traces store model and
# release metadata only; prompts, student records, and generated answers are omitted.
LANGFUSE_TRACING_ENABLED=true
LANGFUSE_BASE_URL=http://127.0.0.1:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Give every client app its own long random gateway token. The three sample
# apps read the matching token below; new registrations receive a token once.
MODEL_GATEWAY_TOKEN_TUTOR_ABHISHEK=replace-with-a-unique-random-secret
MODEL_GATEWAY_TOKEN_TUTOR_SIDDHANT=replace-with-a-different-unique-random-secret
MODEL_GATEWAY_TOKEN_TUTOR_VICKY=replace-with-another-unique-random-secret

# Parent dashboard health checks for the three registered sample applications.
TUTOR_ABHISHEK_HEALTH_URL=http://127.0.0.1:5101/api/health
TUTOR_SIDDHANT_HEALTH_URL=http://127.0.0.1:5102/api/health
TUTOR_VICKY_HEALTH_URL=http://127.0.0.1:5103/api/health
